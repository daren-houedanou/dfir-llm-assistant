# À copier dans deploy/.env puis à compléter. Ne jamais versionner le vrai fichier.
LITELLM_MASTER_KEY=sk-change-me
# Facultatif, uniquement pour le profil hybride (traitement cloud pseudonymisé) :
ANTHROPIC_API_KEY=
MISTRAL_API_KEY=
# config.yaml (hybride) ou config.local-only.yaml (air-gapped)
LITELLM_CONFIG=config.local-only.yaml

# Modèles téléchargés par le conteneur ponctuel ollama-pull (séparés par des espaces) et taille de contexte d'Ollama.
# Sur un portable sans GPU, llama3.2:3b seul est le choix réaliste.
DFA_PULL_MODELS=qwen2.5:7b-instruct llama3.2:3b
OLLAMA_CONTEXT_LENGTH=8192
