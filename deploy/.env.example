# Copy to deploy/.env and fill in. Never commit the real file.
LITELLM_MASTER_KEY=sk-change-me
# Optional, only for the hybrid profile (pseudonymized cloud processing):
ANTHROPIC_API_KEY=
MISTRAL_API_KEY=
# config.yaml (hybrid) or config.local-only.yaml (air-gapped)
LITELLM_CONFIG=config.local-only.yaml

# Models downloaded by the one-shot ollama-pull job (space-separated) and Ollama's context window.
# On a laptop without GPU, llama3.2:3b alone is the realistic choice.
DFA_PULL_MODELS=qwen2.5:7b-instruct llama3.2:3b
OLLAMA_CONTEXT_LENGTH=8192
